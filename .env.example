# Local dev: leave empty — Vite proxies /api → http://127.0.0.1:8317
# Production (Railway monolith): leave VITE_API_URL empty for same-origin /api
VITE_API_URL=

# Local provider/admin login (admin Vite defaults to port 5318)
VITE_ADMIN_SITE_URL=http://127.0.0.1:5180
VITE_PUBLIC_SITE_URL=http://127.0.0.1:5317

# Production example:
# VITE_ADMIN_SITE_URL=
