DATABASE_URL=postgresql://swa:swa_dev_password@localhost:5433/swa
# Production (Railway): reference Postgres DATABASE_URL from Railway dashboard
# Railway may use postgres:// — the app normalizes it automatically

JWT_SECRET=change-me-in-production-use-long-random-string
# Production: openssl rand -hex 32

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=development
# Production: ENVIRONMENT=production

CORS_ORIGINS=http://localhost:5317,http://127.0.0.1:5317,http://localhost:5318,http://127.0.0.1:5318
# Production: https://your-app.up.railway.app,https://your-app.up.railway.app/admin

ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=changeme123
# Only used when no admin user exists (first deploy)

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_VERIFIED_BADGE=
STRIPE_PRICE_FEATURED_PLACEMENT=

# Email — env defaults; admin can also configure Resend / Gmail SMTP in /admin/emails
# Priority when provider=auto: Resend → SMTP → console log
RESEND_API_KEY=
# Generic SMTP (or leave blank and use admin Gmail SMTP settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Gmail SMTP (app password): host smtp.gmail.com port 587 TLS on — set via admin Emails → Settings
EMAIL_FROM=noreply@strugglingwithaddiction.com
POSTAL_ADDRESS=Struggling With Addiction, USA
UPSELL_ALERT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional — Places API key to pull live Google reviews onto rehab listing pages
GOOGLE_PLACES_API_KEY=

PUBLIC_SITE_URL=http://127.0.0.1:5317
ADMIN_SITE_URL=http://127.0.0.1:5318
# Production: your Railway app URL (+ /admin for admin)

S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=swa-uploads
S3_PUBLIC_URL=
UPLOAD_DIR=uploads
